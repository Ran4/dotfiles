{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_DISABLE_MEMORY": "1",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "CLAUDE_CODE_DISABLE_MOUSE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "WebSearch",
      "Read(//home/ran/it_total/ttyd/backend-ttyd/hooks/**)",
      "Read(//home/ran/it_total/ttyd/backend-ttyd/**)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(find:*)",
      "Bash(git checkout:*)",
      "Bash(xargs ls:*)",
      "Bash(do echo \"=== $dir ===\")",
      "Bash(git -C:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(tree:*)",
      "Bash(npm create:*)",
      "Bash(uv run:*)",
      "Bash(grep:*)",
      "Bash(docker compose:*)",
      "Bash(curl:*)",
      "Bash(python3:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ran/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf '\\033[1m%s\\033[0m\\033[32m\\033[0m' \"$(pwd)\""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "watch@claude-video": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "verbose": true,
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
